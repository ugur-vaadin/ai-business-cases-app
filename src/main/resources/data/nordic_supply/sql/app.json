  "bulk_change": {
    "entity": "products",
    "grid_columns": [
      "sku",
      "name",
      "supplier_id",
      "category_id",
      "active"
    ],
    "current_value": {
      "view": "product_current_prices",
      "key": "product_id",
      "column": "list_price"
    },
    "change": {
      "table": "price_history",
      "key": "product_id",
      "value": "list_price",
      "valid_from": "valid_from",
      "valid_to": "valid_to",
      "fixed": {
        "reason": "Supplier increase",
        "currency": "EUR"
      }
    },
    "example": "raise prices 4% on everything from Skarvind AS from the first of next month, except products already on promotion",
