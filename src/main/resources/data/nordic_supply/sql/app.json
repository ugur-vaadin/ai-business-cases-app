  "message_to_record": {
    "entity": "claims",
    "documents": "documents/emails",
    "number_field": "claim_number",
    "fields": [
      "customer_id",
      "order_id",
      "shipment_id",
      "claim_type",
      "priority",
      "source",
      "needed_by",
      "requested_resolution",
      "claimed_amount",
      "description"
    ],
    "section_selector": "claim_type",
    "sections": {
      "DAMAGED": [
        "needed_by",
        "claimed_amount"
      ],
      "MISSING_ITEMS": [
        "needed_by",
        "claimed_amount"
      ],
      "WRONG_ITEM": [
        "needed_by"
      ],
      "LATE_DELIVERY": [
        "claimed_amount"
      ],
      "QUALITY_DEFECT": [
        "claimed_amount"
      ],
      "PRICING_DISPUTE": [
        "claimed_amount"
      ],
      "RETURN_REQUEST": []
    },
    "lookups": [
      {
        "field": "customer_id",
        "from": "customers",
        "label": "name",
        "search": [
          "name",
          "customer_number",
          "email_domain",
          "city"
        ],
        "show": [
          "customer_number",
          "city",
          "country"
        ],
        "filter_by": ""
      },
      {
        "field": "order_id",
        "from": "orders",
        "label": "order_number",
        "filter_by": "customer_id",
        "search": [
          "order_number",
          "customer_reference"
        ],
        "show": [
          "placed_at",
          "promised_delivery_date",
          "status"
        ]
      },
      {
        "field": "shipment_id",
        "from": "shipments",
        "label": "shipment_number",
        "filter_by": "order_id",
        "search": [
          "shipment_number",
          "tracking_number"
        ],
        "show": [
          "delivered_at",
          "carrier",
          "pallet_count"
        ]
      }
    ],
